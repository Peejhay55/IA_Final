# Copie este archivo como .env y complete su clave. NUNCA suba .env al repositorio.

# --- Opción A (por defecto): Groq, capa gratuita — https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Alternativa en Groq con llamadas paralelas a herramientas: qwen/qwen3.6-27b

# --- Opción B: NVIDIA NIM — https://build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Opción C: Ollama local (sin clave) — ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Límite de pasos del loop agéntico (Tmáx)
AGENT_MAX_STEPS=6
# Embeddings del RAG: tfidf (offline, por defecto) | st (sentence-transformers)
RAG_BACKEND=tfidf
